# TLS выпускается и продлевается сам. Ничего вручную настраивать не нужно —
# Caddy получает сертификат Let's Encrypt при первом запросе к домену.
#
# ВАЖНО: домен должен указывать на этот сервер А-записью, и в Cloudflare
# запись должна быть СЕРОЙ (proxy выключен). Оранжевое облако проксирует трафик
# через Cloudflare, и тогда сертификат Caddy выпустить не сможет, а WebSocket
# для подписок пойдёт лишним кругом.

{$API_DOMAIN} {
	encode zstd gzip

	# WebSocket для подписок (presence, сигналинг) и обычный GraphQL — один апстрим.
	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Заголовки, которые дёшевы и закрывают глупые дыры.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}


# Файлы. Браузер ходит сюда напрямую по подписанной ссылке — API в этой цепочке не участвует,
# он только выдаёт ссылку. Отдельный домен, а не путь на api: подпись S3 включает адрес,
# и префикс пути ломает её проверку.
{$FILES_DOMAIN} {
	encode zstd gzip

	# Загрузка материалов и работ. 500 МБ — решение владельца 15.08 (OWNER_SCOPE §22):
	# ограничение дисковое, не юридическое, а получасовой учебный ролик в 200 МБ не влезал.
	#
	# ⚠️ Это число обязано совпадать с `_MATERIAL_MAX` в backend/apps/files/services.py.
	# Разойдись они — файл между двумя порогами грузился бы пять минут и умирал на 413 без
	# объяснения, то есть ровно так, как вёл себя продукт до этой правки.
	request_body {
		max_size 500MB
	}

	reverse_proxy minio:9000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
