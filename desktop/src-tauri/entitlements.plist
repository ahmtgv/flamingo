<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Права основного приложения под hardened runtime.

  Hardened runtime — обязательное условие нотаризации. Он же запрещает ровно то, на чём
  держатся и webview, и сайдкар, поэтому каждая строка ниже названа по причине, а не
  «на всякий случай»: лишнее право в нотаризованном приложении живёт годами.

  🔒 Чего здесь НЕТ и не будет: `com.apple.security.cs.debugger`, `get-task-allow`
  (в релизе они делают приложение отлаживаемым чужим процессом) и любых прав на доступ к
  чужим данным. Камера и микрофон разрешения не требуют — их даёт Info.plist,
  а сюда попадают только под App Sandbox, которого у нас нет.
-->
<plist version="1.0">
<dict>
    <!--
      JavaScriptCore внутри WKWebView компилирует JS в машинный код. Без этого права
      hardened runtime убивает процесс webview на первом же скрипте — то есть приложение
      открывается пустым белым окном.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!--
      Тот же JavaScriptCore: страницы исполняемой памяти, которые он размечает сам.
      Без этого webview падает не сразу, а на сложных страницах — худший вид поломки.
    -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!--
      🔴 Ради сайдкара. PyInstaller раскладывает 65 динамических библиотек рядом с бинарником
      и грузит их на ходу. Мы подписываем их все (`sign.sh`), но проверка библиотек всё равно
      требует, чтобы у них была ТА ЖЕ команда подписи, что у загрузчика; на практике связка
      «Python + расширения» это условие нарушает. Без права сайдкар не стартует, и приложение
      остаётся без своего сервера — то есть без кабинета.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!--
      🔴 Доступ к устройствам под hardened runtime (промпт 23 §2.2). Без App Sandbox камеру
      и микрофон обычно спрашивают строками из Info.plist, но hardened runtime добавляет
      СВОЙ слой — «Resource Access», — и без этих двух прав шаг 4 мастера и урок остались бы
      без картинки и звука. Строки в Info.plist при этом всё равно нужны: они объясняют
      человеку, зачем спрашиваем. Одно не заменяет другое.
    -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
