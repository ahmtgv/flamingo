{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flamingo",
  "version": "0.1.0",
  "identifier": "plus.flamingo.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flamingo",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "resources": [
      "sidecar/**/*"
    ],
    "copyright": "Flamingo",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
