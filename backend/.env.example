# Copy this file to backend/.env (git-ignored) and fill in real values.
# config/settings.py loads backend/.env automatically (python-dotenv); real
# process env vars still override it. NEVER commit backend/.env.

# Django
# In production (DEBUG=0) the app REFUSES to boot on this placeholder, a weak key
# (< 32 chars), or ALLOWED_HOSTS=*. Generate a strong key, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*

# PostgreSQL (PII stored in RF region)
POSTGRES_DB=flamingo
POSTGRES_USER=flamingo
POSTGRES_PASSWORD=flamingo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Channels layer (Redis). Optional in dev — settings falls back to the in-memory
# channel layer when unset. Set in prod so GraphQL subscriptions fan out across workers.
CHANNELS_REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible, Yandex Object Storage)
S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=flamingo
S3_ACCESS_KEY=
S3_SECRET_KEY=

# JWT
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=14

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cabinet portability (Р5.2 / OWNER_SCOPE §18). Where an encrypted copy of a personal cabinet
# may be synced to. Empty = synchronisation is OFF, which is the pilot's state: the data lives
# on the teacher's machine and the server only signals. Whatever this points at receives an
# opaque client-encrypted blob — it never sees readable data about a child.
FLAMINGO_CABINET_SYNC_TARGET=
