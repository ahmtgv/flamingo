# ═══ Flamingo · бэкенд первого куска ═══
# Скопировать в backend/.env и заполнить. В репозиторий .env не попадает.

# Django. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ── Учётные записи ────────────────────────────────────────────────────────────
#
# Где лежит база. По умолчанию backend/flamingo.sqlite3 — на сервере вынести
# в место, которое попадает в бэкап и НЕ лежит внутри папки с кодом.
DB_PATH=

# 🔴 Домен куки. На боевом ровно `.flamingo.plus` — с точкой впереди: тогда куку
# видят и сайт, и api.flamingo.plus. Пусто (разработка) — кука остаётся на своём хосте.
# Ошибиться здесь = вход «работает», но человека каждый раз выкидывает.
SESSION_COOKIE_DOMAIN=

# ── LiveKit: звук, видео и данные доски ───────────────────────────────────────
#
# 🔴 БЕЗ ЭТИХ ТРЁХ СТРОК КОМНАТА НЕ ПОДНИМЕТСЯ. common/livekit.py подписывает токен
# запасным путём, когда ключей нет: издатель «devkey», секрет — SECRET_KEY Django.
# Облако такой токен отклоняет — и сервер молча выдаёт токены, которые никто не примет.
#
# ⚠️ Значения вписывает владелец. Здесь только имена.
# Те же три строки уже лежат в ~/Downloads/flamingo/backend/.env — можно взять оттуда.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
