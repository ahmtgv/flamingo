# ═══ Flamingo · бэкенд первого куска ═══
# Скопировать в backend/.env и заполнить. В репозиторий .env не попадает.

# Django. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ── Учётные записи ────────────────────────────────────────────────────────────
#
# Где лежит база. По умолчанию backend/flamingo.sqlite3 — на сервере вынести
# в место, которое попадает в бэкап и НЕ лежит внутри папки с кодом.
DB_PATH=

# ── Почта: письма о пароле, приглашения в журнал ──────────────────────────────
# Решение владельца 10.10: отправка идёт через Resend (домен flamingo.plus
# подтверждён в Resend записями send/rsend и resend._domainkey в Cloudflare).
# Пусто — письма не уходят, ссылка пишется в журнал сервера. Вход при этом работает.
#
# 🔴 ПОРТ 2587, А НЕ 587. Хостинг сервера закрывает исходящие 587 и 465 (проверено
# 10.10: открыт только 2587). Resend принимает на 2587 то же самое со STARTTLS.
# 🔴 Пароль здесь — API-ключ Resend (начинается с re_), без угловых скобок.
# Вписывает владелец, в чат и в репозиторий ключ не попадает.
# 🔴 hello@whiteobservatory.com отправителем НЕ ставить никогда: тот адрес только
# принимает почту, и его домен — не наш.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=2587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=
DEFAULT_FROM_EMAIL=Flamingo <no-reply@flamingo.plus>

# 🔴 Домен куки. На боевом ровно `.flamingo.plus` — с точкой впереди: тогда куку
# видят и сайт, и api.flamingo.plus. Пусто (разработка) — кука остаётся на своём хосте.
# Ошибиться здесь = вход «работает», но человека каждый раз выкидывает.
SESSION_COOKIE_DOMAIN=

# ── LiveKit: звук, видео и данные доски ───────────────────────────────────────
#
# 🔴 БЕЗ ЭТИХ ТРЁХ СТРОК КОМНАТА НЕ ПОДНИМЕТСЯ. common/livekit.py подписывает токен
# запасным путём, когда ключей нет: издатель «devkey», секрет — SECRET_KEY Django.
# Облако такой токен отклоняет — и сервер молча выдаёт токены, которые никто не примет.
#
# ⚠️ Значения вписывает владелец. Здесь только имена.
# Те же три строки уже лежат в ~/Downloads/flamingo/backend/.env — можно взять оттуда.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Исследование внимания SEduM (добровольцы, решение владельца 06.10) ────────
#
# Куда пишутся записи проверок: видео, точки лица, события. НЕ рядом с кодом и
# не в пособиях. Папку завести заранее и отдать пользователю gunicorn.
SCIENCE_ROOT=/var/lib/flamingo/science
# Потолки (по умолчанию: кусок 24 МБ, проверка 600 МБ, доброволец 20 ГБ,
# оставить свободными 3 ГБ). Пусто — значения по умолчанию.
SCIENCE_CHUNK_MAX_MB=
SCIENCE_RUN_MAX_MB=
SCIENCE_VOLUNTEER_MAX_GB=
SCIENCE_FREE_MIN_GB=
