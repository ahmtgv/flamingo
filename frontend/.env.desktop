# Сборка приложения преподавателя (Tauri). Отдельный режим, а не общий .env.
#
# 🔴 Зачем отдельный файл. Внутри приложения страница отдаётся протоколом `tauri://localhost`,
# и умолчание `/graphql/` из shared/lib/env.ts указывало бы В САМО ПРИЛОЖЕНИЕ — туда, где
# никакого API нет. В браузере то же умолчание работает, потому что сайт и API стоят за одним
# обратным прокси. Поэтому у десктопа адрес обязан быть абсолютным и записан здесь.
#
# Приложение ходит на СЕРВЕР: учётки, расписание, группы, зеркало ученика и связывание машины
# живут там. Sidecar на 127.0.0.1 — это кабинет и комната урока, у него свой путь.
VITE_GRAPHQL_HTTP_URL=https://api.flamingo.plus/graphql/
VITE_GRAPHQL_WS_URL=wss://api.flamingo.plus/graphql/

# Канонический адрес продукта: с него печатаются ссылки приглашения и адрес связывания машины.
VITE_PUBLIC_ORIGIN=https://flamingo.plus

# ⚠️ VITE_PREVIEW здесь НЕ выставляется и не должен: приложение идёт в настоящий API.
