# Same-origin GraphQL path. The Vite dev server (and a prod reverse proxy)
# forward it to the API, so the browser never makes a cross-origin request.
VITE_GRAPHQL_HTTP_URL=/graphql/

# Optional override for the GraphQL-subscriptions WebSocket endpoint. Defaults to the
# same-origin /graphql/ upgraded to ws(s):// — only set this to point subscriptions elsewhere.
# VITE_GRAPHQL_WS_URL=

# Where the Vite dev proxy forwards /graphql during local development.
VITE_PROXY_TARGET=http://localhost:8000

# LiveKit server URL for the live video room (public wss URL; the API key/secret
# stay server-side in backend/.env). Copy this file to frontend/.env and set it.
VITE_LIVEKIT_URL=

# TEMPORARY preview flag. Set VITE_PREVIEW=1 to boot the app already "authenticated"
# so the design can be browsed without a backend (login/register screens are skipped).
# Leave UNSET in dev, tests, and real production. Remove once a backend is hosted.
VITE_PREVIEW=

# Канонический адрес продукта — тот, что печатается людям (решение владельца 14.08).
# Ссылка группы собирается ТОЛЬКО отсюда: панель могут открыть на стенде или на localhost,
# и скопированная оттуда ссылка ушла бы классу, не открывшись ни у кого.
# Пусто в разработке — панель честно скажет об этом на экране.
VITE_PUBLIC_ORIGIN=https://flamingo.plus
