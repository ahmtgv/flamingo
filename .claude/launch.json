{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flamingo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "flamingo-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--mode",
        "preview",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "flamingo-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "-s",
        "frontend/dist",
        "-l",
        "5180"
      ],
      "port": 5180
    }
  ]
}
